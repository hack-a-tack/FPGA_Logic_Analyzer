  Serial.begin(115200);

  // Explicitly set inputs/outputs
  pinMode(16, OUTPUT);                // MOSI
  pinMode(15, OUTPUT);                // SCK
  pinMode(14, INPUT);                 // MISO
  pinMode(chipSelectPin, OUTPUT);     // CS#
  digitalWrite(chipSelectPin, HIGH);  // default high

