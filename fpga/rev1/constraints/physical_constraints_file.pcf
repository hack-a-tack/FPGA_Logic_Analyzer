# iCE40UP5K Logic Analyzer, Rev1
# Physical Constraints File

# Sampling signals
set_io i_LA0 48 -pullup yes
set_io i_LA1 47 -pullup yes
set_io i_LA2 46 -pullup yes
set_io i_LA3 45 -pullup yes
set_io i_LA4 43 -pullup yes
set_io i_LA5 42 -pullup yes
set_io i_LA6 38 -pullup yes
set_io i_LA7 36 -pullup yes

# LED signals
set_io o_UART_TX_LED 12
set_io o_UART_RX_LED 11
set_io o_USER_LED 10

# Config signals
# Note that i_RESET is used for the i_CRESET_B pin
set_io i_RESET 8

# UART signals
set_io o_UART_TX 4
set_io i_UART_RX 3
